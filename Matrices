'''
ORDENAMIENTO
'''

def ordenar_matriz(matriz, columna):

    for i in range(len(matriz) - 1):

        for j in range(len(matriz) - 1 - i):

            if matriz[j][columna] > matriz[j + 1][columna]:

                aux = matriz[j]
                matriz[j] = matriz[j + 1]
                matriz[j + 1] = aux


'''
SELECCIÓN DE COLUMNA
'''

def seleccionar_columna(cantidad_columnas):

    columna = int(input("Ingrese el número de columna por la cual desea ordenar: "))

    while columna < 1 or columna > cantidad_columnas:

        print("Error: número de columna inválido.")

        columna = int(input("Ingrese un número de columna válido: "))

    return columna - 1

'''
MATRIZ ESTADISTICA
'''

def matriz_estadisticas():

    matriz = [
        [0, 0],    # Particular
        [0, 0]     # Obra Social
    ]

    for venta in matriz_ventas:

        id_cliente = venta[1]
        receta = venta[4]

        posicion_cliente = -1

        for i in range(len(matriz_clientes)):

            if matriz_clientes[i][0] == id_cliente:
                posicion_cliente = i

        if posicion_cliente != -1:

            cobertura = matriz_clientes[posicion_cliente][3]

            fila = cobertura - 1
            columna = receta - 1

            matriz[fila][columna] += 1

    return matriz


def mostrar_estadistica(matriz):

